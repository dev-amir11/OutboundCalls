DATABASE_URL="postgresql://postgres:postgres@localhost:51218/outbound?sslmode=disable"
TELEPHONY_PROVIDER=mock
NEXT_PUBLIC_APP_URL=http://localhost:3000
STORAGE_PROVIDER=local
AUTH_SECRET="replace-with-a-long-random-string"
APP_TIMEZONE=UTC
MOCK_STEP_MS=2000
ADMIN_EMAIL=admin@outbound.local
ADMIN_PASSWORD=ChangeMe123!

# LiveKit owns the call session. Telnyx/Telorca is the SIP trunk LiveKit dials through.
# Set TELEPHONY_PROVIDER=livekit only after these values are present.
# LIVEKIT_URL=https://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# TELNYX_PHONE_NUMBER=+15550001111
# Use an existing trunk, or let the desk create one from the Telnyx SIP credentials.
# LIVEKIT_SIP_TRUNK_ID=
# TELNYX_SIP_ADDRESS=sip.telnyx.com
# TELNYX_SIP_USERNAME=
# TELNYX_SIP_PASSWORD=
# Place Call dial settings (also used by /api/calls/listen)
# CALLER_ID=13156938488
# DIAL_PREFIX=43084
# Place Call AMD: run `npm run agent` so LiveKit Agents can classify human vs machine.
# Self-hosted: Deepgram STT + Google Gemini LLM (not LiveKit Cloud Inference).
# DEEPGRAM_API_KEY=
# GOOGLE_API_KEY=
# LIVEKIT_AGENT_NAME=place-call-amd
